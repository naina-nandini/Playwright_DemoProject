{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "description": "Production-ready Playwright TypeScript framework with design patterns",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:visual": "playwright test tests/visual",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:parallel": "playwright test --workers=4",
    "report": "playwright show-report",
    "report:allure": "allure generate ./allure-results --clean && allure open",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "clean": "rimraf test-results playwright-report allure-results allure-report",
    "pretest": "npm run clean",
    "install:browsers": "playwright install"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "framework",
    "page-object-model",
    "design-patterns"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "allure-commandline": "^2.25.0",
    "allure-playwright": "^2.15.1",
    "dotenv": "^16.4.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^0.21.0",
    "prettier": "^3.2.4",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@faker-js/faker": "^8.3.1",
    "winston": "^3.11.0"
  }
}
